# Copy to .env and adjust. Never commit .env.

PORT=3000

# PostgreSQL connection (required: DB_HOST, DB_NAME, DB_USER).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopkeeper
DB_USER=shopkeeper
DB_PASSWORD=

# TLS: "true" enables TLS with full certificate and hostname verification.
DB_SSL=false
# Optional PEM bundle for servers signed by a private CA (e.g. a cloud provider's RDS CA).
# DB_SSL_CA_FILE=/path/to/ca-bundle.pem
