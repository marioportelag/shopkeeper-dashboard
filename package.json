{
  "name": "shopkeeper-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Server-rendered dashboard of monthly business listings per broker (Express, Handlebars, PostgreSQL).",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test \"test/integration/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marioportelag/shopkeeper-dashboard.git"
  },
  "author": "Mario Portela",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.6.1",
    "datatables.net": "^3.1.4",
    "datatables.net-dt": "^3.1.4",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
