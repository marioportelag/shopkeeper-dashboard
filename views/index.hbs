<header class="page-header">
  <h1>ShopKeeper Dashboard</h1>
  <p class="subtitle">Monthly listings per broker · {{range.label}}</p>
</header>

<form class="range-form" method="get" action="/">
  <label>From <input type="month" name="from" value="{{range.from}}" required /></label>
  <label>To <input type="month" name="to" value="{{range.to}}" required /></label>
  <button type="submit">Apply</button>
</form>

<section class="card" aria-label="Listings per month">
  <canvas id="listing-chart" role="img" aria-label="Line chart of monthly listings per broker"></canvas>
</section>

<section class="card">
  {{#if tableRows.length}}
    <table id="broker-table" class="display">
      <thead>
        <tr>
          <th>Month</th>
          <th>Broker</th>
          <th>Site ID</th>
          <th>Total listings</th>
          <th>Average revenue</th>
        </tr>
      </thead>
      <tbody>
        {{#each tableRows}}
          <tr>
            <td data-order="{{month}}">{{monthLabel}}</td>
            <td>{{broker}}</td>
            <td>{{siteId}}</td>
            <td>{{totalListings}}</td>
            <td>{{avgRevenue}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="empty-state">No listings were found for this period.</p>
  {{/if}}
</section>

{{! Data only: type="application/json" is never executed, and jsonScript escapes < > & so values cannot close the element. }}
<script type="application/json" id="chart-data">{{jsonScript chart}}</script>